{
  "$schema": "https://opencode.ai/config.json",
  "skills": [
    "./skills/01-gamedev-unity",
    "./skills/02-gamedev-godot",
    "./skills/03-3d-blender",
    "./skills/04-video-youtube",
    "./skills/05-marketing-seo-copy",
    "./skills/06-automacao-redes-sociais",
    "./skills/08-produtividade-documentos",
    "./skills/09-ia-workflows-antigravity"
  ],
  "mcp": {
    "servers": {
      "unity-mcp": {
        "type": "local",
        "command": ["C:\\Users\\alexa\\.unity\\relay\\relay_win.exe", "--mcp"]
      },
      "blender": {
        "type": "local",
        "command": ["uvx", "--python", "3.11", "mcp-for-blender"],
        "environment": {
          "UV_PYTHON_PREFERENCE": "only-managed",
          "PYTHONIOENCODING": "utf-8"
        }
      },
      "gamemaker": {
        "type": "local",
        "command": ["node", "D:\\GitHub\\gamemaker-antigravity-mcp\\dist\\index.js"]
      },
      "stitch": {
        "type": "remote",
        "url": "https://stitch.googleapis.com/mcp",
        "oauth": false,
        "headers": {
          "X-Goog-Api-Key": "{env:STITCH_API_KEY}"
        }
      },
      "canva": {
        "type": "remote",
        "url": "https://mcp.canva.com/mcp"
      }
    }
  }
}
